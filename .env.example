# FireflyIII-AI-Categorizer Development Environment
# Copy this to .env and fill in your values, or export these in your shell.

# --- Go toolchain ---
# Installed at: /opt/data/tools/go/go/bin/go
export PATH=/opt/data/tools/go/go/bin:$PATH

# --- Firefly III connection (for testing with real data) ---
# FIREFLY_URL=https://firefly.asaezs.com
# FIREFLY_PERSONAL_TOKEN=your_firefly_pat_here

# --- AI Provider (choose one) ---
# AI_PROVIDER=openai          # openai | gemini | deepseek
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # leave empty for OpenAI, or set for Ollama/Azure

# AI_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=...
# DEEPSEEK_MODEL=deepseek-chat

# --- Server ---
PORT=3000
ENABLE_UI=true
CONFIG_FILE=./config.json
TAG_PREFIX=ai

# --- Processing ---
WORKER_CONCURRENCY=1
BATCH_CONCURRENCY=5
HISTORY_CONTEXT_LIMIT=5
HISTORY_LOOKBACK_DAYS=90
HISTORY_CACHE_TTL=10m

# --- Review optimization ---
# TTL for the in-memory review groups cache (frontend polls every 30s).
# Set to 0 to disable caching.
REVIEW_CACHE_TTL=30s
# Lookback window in days for the review scan. 365 captures 74% of all
# review-tagged transactions while scanning only ~3 pages instead of 144.
# Set to 0 to scan full history (slower but complete).
REVIEW_LOOKBACK_DAYS=365
